# Pearl's Ladder Environment Configuration
# Local development environment

# Database Configuration
POSTGRES_DB=pearl_ladder
POSTGRES_USER=pearl_user
POSTGRES_PASSWORD=pearl_dev_password

# Neo4j Configuration
NEO4J_PASSWORD=pearl_neo4j_password

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=pearl_admin

# Redis Configuration
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# External API Keys (for BenchmarkValidator)
ALPHA_VANTAGE_API_KEY=demo
FRED_API_KEY=demo
BLOOMBERG_API_KEY=demo

# Performance Configuration
PERFORMANCE_TARGET_RUNG1=50000
PERFORMANCE_TARGET_RUNG2=500000000
PERFORMANCE_TARGET_RUNG3=10000000000

# GDPR Compliance Settings
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=30
ANONYMIZE_DATA=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=causal-router

# Service Configuration
SERVICE_HOST=0.0.0.0
LADDER_ESCALATOR_PORT=8001
BENCHMARK_VALIDATOR_PORT=8002
KAFKA_ROUTER_PORT=8003
