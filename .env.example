# Pearl's Ladder Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRES_DB=pearl_ladder
POSTGRES_USER=pearl_user
POSTGRES_PASSWORD=your_secure_password_here

# Neo4j Configuration
NEO4J_PASSWORD=your_neo4j_password_here

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# Kafka Configuration
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# External API Keys (for BenchmarkValidator)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FRED_API_KEY=your_fred_api_key_here
BLOOMBERG_API_KEY=your_bloomberg_key_here

# Performance Configuration
PERFORMANCE_TARGET_RUNG1=50000
PERFORMANCE_TARGET_RUNG2=500000000
PERFORMANCE_TARGET_RUNG3=10000000000

# GDPR Compliance Settings
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=30
ANONYMIZE_DATA=true

# Grok API Configuration (optional)
GROK_API_ENDPOINT=https://api.grok.example.com/v1
GROK_API_KEY=your_grok_api_key_here
GROK_API_TIMEOUT=30
GROK_API_MAX_RETRIES=3

# Query Routing Configuration
ROUTING_ENGINE_ENABLED=true
DEFAULT_PROCESSING_METHOD=local_nlp
ENABLE_USER_PREFERENCES=true
ENABLE_STORYLINE_RESPONSES=true

# System Health Monitoring Configuration
HEALTH_MONITORING_ENABLED=true
HEALTH_METRICS_RETENTION_HOURS=168  # 7 days
HEALTH_ALERT_THRESHOLDS_EXECUTION_TIME_MS=100
HEALTH_ALERT_THRESHOLDS_SLIPPAGE_BPS=5.0
HEALTH_ALERT_THRESHOLDS_API_RESPONSE_MS=10
EDGE_OPTIMIZATION_DETECTION_ENABLED=true
ML_ANALYTICS_TRAINING_ENABLED=true
WEEKLY_REPORT_GENERATION_ENABLED=true

# Auto-scaling Configuration
AUTOSCALING_ENABLED=true
AUTOSCALING_NAMESPACE=default
AUTOSCALING_COOLDOWN_SECONDS=300
AUTOSCALING_MAX_REPLICAS=50
AUTOSCALING_MIN_REPLICAS=2
AUTOSCALING_CPU_THRESHOLD=70
AUTOSCALING_MEMORY_THRESHOLD=80
AUTOSCALING_EXECUTION_TIME_THRESHOLD_MS=100
AUTOSCALING_TRADES_PER_SECOND_THRESHOLD=1000
GPU_AUTOSCALING_ENABLED=true
GPU_AUTOSCALING_MAX_NODES=10
GPU_AUTOSCALING_MIN_NODES=1
GPU_AUTOSCALING_UTILIZATION_THRESHOLD=80

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=causal-router

# Service Configuration
SERVICE_HOST=0.0.0.0
LADDER_ESCALATOR_PORT=8001
BENCHMARK_VALIDATOR_PORT=8002
KAFKA_ROUTER_PORT=8003
