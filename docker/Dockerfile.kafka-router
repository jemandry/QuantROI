FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install setuptools first
RUN pip install --upgrade pip setuptools wheel

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY ai-models/src/kafka_causal_router.py .
COPY ai-models/src/audit_trail_manager.py .
COPY ai-models/src/__init__.py .

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONOPTIMIZE=1
ENV KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Expose port for microservice
EXPOSE 8003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8003/health')" || exit 1

# Run the microservice
CMD ["python", "-m", "uvicorn", "kafka_causal_router:app", "--host", "0.0.0.0", "--port", "8003"]
