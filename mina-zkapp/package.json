{
  "name": "quantroi-mina-zkapp",
  "version": "1.0.0",
  "description": "Mina Protocol zkApp for QuantROI strategy verification",
  "main": "build/src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "buildw": "tsc --watch",
    "coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "format": "prettier --write --ignore-unknown **/*",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "testw": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "lint": "npx eslint src/ tests/ --fix"
  },
  "keywords": [
    "mina-zkapp",
    "mina-protocol",
    "zero-knowledge",
    "blockchain",
    "fintech"
  ],
  "author": "QuantROI Platform",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-typescript": "^7.16.0",
    "@types/jest": "^27.0.3",
    "@typescript-eslint/eslint-plugin": "^5.5.0",
    "@typescript-eslint/parser": "^5.5.0",
    "eslint": "^8.7.0",
    "jest": "^27.4.5",
    "prettier": "^2.5.1",
    "ts-jest": "^27.1.2",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "o1js": "^1.0.0"
  },
  "peerDependencies": {
    "o1js": "1.x"
  },
  "engines": {
    "node": ">=16.4.0"
  }
